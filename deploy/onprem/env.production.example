# Copy to /etc/arabtec-workspace.env  (owner root:arabtec, mode 0640)
# install-server.sh generates this file with real secrets already filled in.

NODE_ENV=production
PORT=3000

# MySQL 8 on the loopback interface. This app is MySQL, not PostgreSQL:
# drizzle.config.ts sets dialect "mysql" and every migration uses MySQL syntax.
DATABASE_URL=mysql://arabtec_app:REPLACE_ME@127.0.0.1:3306/arabtec_workspace

# openssl rand -hex 32
JWT_SECRET=REPLACE_ME

# The first administrator, created on first successful sign-in.
ADMIN_EMAIL=hr@arabtec.local
ADMIN_PASSWORD=REPLACE_ME
ADMIN_NAME=Workspace Administrator

# openssl rand -hex 32 — guards the review-reminder endpoint.
CRON_SECRET=REPLACE_ME

# Outside the deploy directory so a redeploy never deletes uploaded images.
UPLOAD_DIR=/var/lib/arabtec-workspace/uploads

# Optional. Without these, overdue reviews are still flagged in the console
# and only the outbound email is skipped.
# RESEND_API_KEY=
# WORKSPACE_REMINDER_FROM=workspace@arabtec.local

# Deliberately absent, unlike the previous deployment:
#   TUNNEL_TOKEN     - Cloudflare tunnel, not used on the internal network
#   BUILT_IN_FORGE_* - Manus hosted storage; uploads now go to UPLOAD_DIR
